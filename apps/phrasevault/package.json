{
    "name": "phrasevault",
    "version": "3.0.0",
    "description": "Save time with PhraseVault, a fast text expander for Windows & macOS.",
    "type": "module",
    "main": ".vite/build/main.cjs",
    "scripts": {
        "start": "pnpm run build:css && pnpm run build:renderer && cross-env NODE_ENV=development electron-forge start",
        "dev": "pnpm run build:css && pnpm run build:renderer && cross-env NODE_ENV=development electron-forge start",
        "watch": "cross-env NODE_ENV=development electronmon .",
        "build:renderer": "vite build --config vite.renderer.config.ts",
        "rebuild": "electron-rebuild --force",
        "postinstall": "node -e \"require('electron/install.js')\" && electron-rebuild --force",
        "make": "node build-package.cjs --yes --nosign",
        "make:dev": "node build-package.cjs --yes --nosign",
        "velopack": "node velopack.cjs --yes --nosign",
        "dmg": "node dmg.cjs --nosign",
        "colors": "node ../../packages/shared/bin/generate-colors.js --config colors.json --output assets/css/generated-colors.css",
        "icons": "node ../../packages/shared/bin/generate-app-icons.cjs --config icons.config.json",
        "typecheck": "tsc --noEmit",
        "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/output.css --minify",
        "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/output.css --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build:e2e": "pnpm run build:css && pnpm run build:renderer && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
        "test:e2e": "pnpm run build:e2e && node ../../node_modules/@playwright/test/cli.js test",
        "test:e2e:hello": "pnpm run build:e2e && node ../../node_modules/@playwright/test/cli.js test e2e/smoke.spec.ts --grep \"hello world\"",
        "test:visual": "pnpm run build:e2e && node ../../node_modules/@playwright/test/cli.js test e2e/screenshot.spec.ts"
    },
    "keywords": [
        "phrase",
        "management",
        "tool",
        "text expander",
        "phrase expander",
        "productivity"
    ],
    "author": "SPQRK Web Solutions",
    "license": "SEE LICENSE IN LICENSE.md",
    "dependencies": {
        "@hurdlegroup/robotjs": "^0.12.3",
        "@spqrkapps/shared": "workspace:*",
        "i18next": "^26.4.2",
        "node-window-manager": "^2.2.4",
        "sqlite3": "^6.0.1",
        "velopack": "^1.2.0"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@electron-forge/cli": "^7.11.0",
        "@electron-forge/plugin-auto-unpack-natives": "^7.11.0",
        "@electron-forge/plugin-vite": "^7.11.0",
        "@electron/rebuild": "^4.2.0",
        "@tailwindcss/cli": "4.3.3",
        "tailwindcss": "4.3.3",
        "@types/node": "^22.0.0",
        "@vitest/coverage-v8": "5.0.0",
        "concurrently": "^9.2.0",
        "cross-env": "^7.0.3",
        "culori": "^4.0.2",
        "electron": "catalog:",
        "electronmon": "^2.0.0",
        "fs-extra": "^11.3.2",
        "license-checker-rseidelsohn": "^4.4.0",
        "node-abi": "^4.35.0",
        "png-to-ico": "^3.0.1",
        "sharp": "^0.34.5",
        "tsx": "^4.19.0",
        "typescript": "^5.9.0",
        "vite": "^6.4.1",
        "vitest": "5.0.0"
    },
    "config": {
        "forge": "forge.config.cjs"
    }
}
