{
  "name": "phrasevault-source",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "PhraseVault source workspace (app + shared Electron utilities)",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter phrasevault start",
    "start": "pnpm --filter phrasevault start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:shared": "pnpm --filter @spqrkapps/shared test",
    "test:e2e": "pnpm --filter phrasevault test:e2e",
    "colors": "pnpm --filter phrasevault colors",
    "icons": "pnpm --filter phrasevault icons",
    "build:css": "pnpm --filter phrasevault build:css",
    "make": "pnpm --filter phrasevault make"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/typography": "^0.5.16",
    "@vitest/coverage-v8": "5.0.0",
    "png2icons": "^2.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "overrides": {
      "node-abi": "^4.35.0"
    }
  }
}
